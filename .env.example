# Copy to .env (gitignored) and fill in. Loaded by backend core/config.py and `just`.

# --- Core infra (local defaults match docker-compose) ---
DATABASE_URL=postgresql+asyncpg://shouldibuy:shouldibuy@localhost:5432/shouldibuy
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=shouldibuy

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Data sources ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION          # or SANDBOX
SERPAPI_API_KEY=

# --- LLM / vision provider ---
LLM_API_KEY=
LLM_MODEL_CANONICALIZE=cheap-model
LLM_MODEL_SYNTHESIZE=strong-model
VISION_MODEL=vision-model

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shouldibuy

# --- App ---
APP_ENV=local                # local | ci | prod
COMP_CACHE_TTL_SECONDS=43200
